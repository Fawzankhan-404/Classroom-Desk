{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classroom-desk-selfhosted",
  "main": "src/final-worker.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true, "redact_query_string": true },
  "routes": [],
  "d1_databases": [{"binding":"DB","database_name":"replace-with-your-own-database","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "vars": {"V2_AUTH_TABLE":"classroom_desk_auth_records","V2_PUBLIC_APP_ORIGIN":"https://your-domain.example","V2_PICKER_CALLBACK_URL":"https://your-domain.example/picker/callback","V2_PUBLIC_OPERATOR_NAME":"Your Classroom Desk","V2_PUBLIC_SUPPORT_EMAIL":"support@example.invalid","SAAS_BILLING_UI_ENABLED":"false","SAAS_RECONCILIATION_ENABLED":"false","SAAS_TEACHER_FEATURES_ENABLED":"false","SAAS_REFERRAL_REWARDS_ENABLED":"false","SAAS_ENFORCE_ENTITLEMENTS":"true"},
  "ratelimits": [{"name":"V2_PUBLIC_RATE_LIMIT","namespace_id":"1001","simple":{"limit":300,"period":60}},{"name":"V2_AUTH_RATE_LIMIT","namespace_id":"1002","simple":{"limit":20,"period":60}}]
}
