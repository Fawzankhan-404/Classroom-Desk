{
  "name": "classroom-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "gpt-google-classroom": "dist/index.js"
  },
  "dependencies": {
    "@googleapis/classroom": "^15.0.0",
    "@googleapis/drive": "^22.0.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@neondatabase/serverless": "^1.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "officeparser": "^8.0.0",
    "open": "^10.2.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/express": "^5.0.6",
    "@types/node": "^24.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "A free, open-source Google Classroom assistant powered by ChatGPT.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:worker": "wrangler deploy --config wrangler.example.jsonc --dry-run",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts --maxWorkers=1",
    "auth": "tsx src/auth.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js"
  }
}