# Local development only. Keep real values in an ignored .env file or secret manager.
NODE_ENV=development
PUBLIC_APP_ORIGIN=http://127.0.0.1:8787
MCP_RESOURCE_URL=http://127.0.0.1:8787/mcp
GOOGLE_OAUTH_CALLBACK_URL=http://127.0.0.1:8787/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
PUBLIC_AUTH_STORE=memory
DATABASE_URL=
PUBLIC_AUTH_ENCRYPTION_KEY_B64=
PUBLIC_OPERATOR_NAME=Local Classroom Desk
PUBLIC_SUPPORT_EMAIL=developer@example.invalid

# Optional homepage media; HTTPS CloudFront URLs only
PUBLIC_STAGE_WIDE_VIDEO_URL=
PUBLIC_STAGE_WIDE_POSTER_URL=
PUBLIC_STAGE_NARROW_VIDEO_URL=
PUBLIC_STAGE_NARROW_POSTER_URL=
